# Nerrico backend configuration
# Copy this file to `.env` and fill in your keys. Never commit `.env`.

# Server port (frontend default expects 4000)
PORT=4000

# Logging: debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# ElevenLabs (voiceover with word timestamps) — REQUIRED for reels
ELEVENLABS_API_KEY=
# Optional default voice id
ELEVENLABS_VOICE_ID=
# Optional override for the Hindi narrator voice id
# HINDI_VOICE_ID=

# ---------------------------------------------------------------------------
# AI image generation (src/providers/images/)
# IMAGE_PROVIDER picks the provider — a single name or a comma-separated
# fallback chain. Supported: cloudflare, gemini, openai, flux, stability,
# pollinations. Unset = auto (every provider with credentials, keyless
# Pollinations last). Changing providers is config-only.
# IMAGE_PROVIDER=cloudflare,pollinations

# Cloudflare Workers AI (free tier: 10k neurons/day)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Gemini (AI Studio) — free tier currently has 0 image quota/day; needs billing
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# OpenAI Images
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# FLUX (Black Forest Labs, https://api.bfl.ai)
# BFL_API_KEY=
# FLUX_MODEL=flux-dev

# Stable Diffusion (Stability AI, https://platform.stability.ai)
# STABILITY_API_KEY=
# STABILITY_IMAGE_MODEL=core

# ---------------------------------------------------------------------------
# Stock photo fallback (src/providers/stock.js): Pexels/Pixabay -> Openverse
# (no key) -> Wikimedia Commons (no key) -> icon scene.
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
